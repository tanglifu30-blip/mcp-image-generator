# API配置 (必填)
# OpenAI API密钥
OPENAI_API_KEY=sk-your-api-key-here

# API端点 (可选，默认为OpenAI官方)
# 支持NewAPI、OpenAI官方、或其他兼容端点
OPENAI_API_BASE=https://api.openai.com

# 图片存储路径 (可选)
# Windows示例: A:\Claude使用image出图
# macOS/Linux示例: ~/claude-images
IMAGE_STORAGE_PATH=

# 默认模型 (可选)
# 可选: gpt-image-2.5-flare, gpt-image-2.5-sunburst, gpt-image-2, gpt-image-2.5
DEFAULT_MODEL=gpt-image-2.5-flare

# 默认图片尺寸 (可选)
# 可选: 256x256, 512x512, 1024x1024, 1792x1024, 1024x1792
DEFAULT_SIZE=1024x1024

# 默认图片质量 (可选)
# 可选: low, medium, high, auto
DEFAULT_QUALITY=high
